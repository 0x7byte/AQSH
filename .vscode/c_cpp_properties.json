        "/tmp/aquashield-platformio/packages/framework-arduinoespressif32/libraries/**",
        "/tmp/aquashield-platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/include/**"
      ],
      "defines": [
        "ARDUINO=10812",
        "ARDUINO_ARCH_ESP32",
        "ESP32",
        "ARDUINO_ESP32_DEV"
      ]
    }
